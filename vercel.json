{
    "version": 2,
    "builds": [
      {
        "src": "index.html",
        "use": "@vercel/static"
      },
      {
        "src": "chat.html",
        "use": "@vercel/static"
      },
      {
        "src": "api/*",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/chat",
        "dest": "/api/chat.js"
      },
      {
        "src": "/chat",
        "dest": "/chat.html"
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ]
  }
  