{
  "version": 2,
  "builds": [
    {
      "src": "templates/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/templates/$1",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/",
      "dest": "/templates/index.html"
    },
    {
      "src": "/admin.html",
      "dest": "/templates/admin.html"
    }
  ]
}